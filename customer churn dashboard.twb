      <column caption='Churn Customer' datatype='integer' name='[Calculation_1013505709924352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Churn] = &quot;Yes&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Retained Customer' datatype='integer' name='[Calculation_1013505710301185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Churn] = &quot;No&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Churn Rate' datatype='real' name='[Calculation_1013505710374914]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1013505709924352])/COUNT([customerID])' />
      </column>
      <column caption='Tenure Group' datatype='string' name='[Calculation_1013505744474115]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [tenure] &lt;= 12 THEN &quot;0-12 Months&quot;&#13;&#10;ELSEIF [tenure] &lt;= 24 THEN &quot;13-24 Months&quot;&#13;&#10;ELSEIF [tenure] &lt;= 36 THEN &quot;25-36 Months&quot;&#13;&#10;ELSEIF [tenure] &lt;= 48 THEN &quot;37-48 Months&quot;&#13;&#10;ELSEIF [tenure] &lt;= 60 THEN &quot;49-60 Months&quot;&#13;&#10;ELSE &quot;60+ Months&quot;&#13;&#10;END' />
      </column>
